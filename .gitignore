# Environment variables and secrets. Only the documented example files are tracked.
.env
.env.*
!.env.example
secrets.json
api_keys.json

# Local databases (the legacy SQLite files are no longer tracked)
*.db
*.sqlite3

# Node / Next.js / Expo
node_modules/
.next/
out/
.expo/
dist/
web-build/
*.tsbuildinfo
.netlify/

# Python bytecode, in case any local research scripts are run
__pycache__/
*.py[cod]
.venv/
venv/

# Logs and coverage
*.log
logs/
coverage/
htmlcov/

# Editors and OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
