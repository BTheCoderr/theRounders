{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_ROUNDERS_API_URL": "https://therounders.netlify.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
