# therounders server-side environment configuration
# Copy to native/.env.local for local development ONLY. Never commit actual values.
# The existing Netlify site already contains the Supabase URL and service role key.
SUPABASE_URL=https://ykvsjnvpgdxsekqdhivz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Add this on Netlify, scope: server/build/functions; NEVER NEXT_PUBLIC_ or EXPO_PUBLIC_.
OPENAI_API_KEY=
ROUNDERS_AI_ENABLED=true
ROUNDERS_AI_MODEL=gpt-4.1-mini
# Sportsbook quotes are independent of archived ESPN completed game results.
ODDS_API_KEY=
# Champion model per sport (rounders-v1 | power-v2 | rpi-v2.1). Default rounders-v1.
# Change only after /api/performance shows the promotion gate recommends the challenger.
ROUNDERS_CHAMPION_NBA=
ROUNDERS_CHAMPION_NFL=
# Supabase publishable key (also used server-side to verify sign-in tokens for plan checks).
NEXT_PUBLIC_SUPABASE_URL=https://ykvsjnvpgdxsekqdhivz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Stripe, TEST MODE ONLY. The server refuses sk_live_/rk_live_ keys and live-mode webhooks.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_PRO=price_
STRIPE_PRICE_EDGE=price_
# Public site origin for Checkout return URLs (optional; defaults to the request origin).
ROUNDERS_SITE_URL=https://therounders.netlify.app
